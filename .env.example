# ── Doggli Pet Care — environment variables ─────────────────────────────────
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored. On Vercel, add these in Project Settings → Environment Variables.
#
# How submissions are delivered:
#   • Formspree  → notifies you + logs every submission to an exportable
#                  spreadsheet. Works out of the box (default endpoint below).
#   • Resend     → sends the customer a branded confirmation email. Optional;
#                  needs an API key AND a verified sending domain.
# Forms never show a fallback popup — Formspree carries everything on its own.

# Formspree form endpoint. Defaults to the existing Doggli form if unset.
# Create your own free form at https://formspree.io to get a clean dashboard.
FORMSPREE_ENDPOINT=https://formspree.io/f/xbdapwvq

# Resend API key for branded customer confirmation emails (free tier at
# https://resend.com). Leave empty to skip branded emails — submissions still
# work via Formspree.
RESEND_API_KEY=

# The "from" address branded emails are sent as. To email *customers*, this
# must be on a domain you've VERIFIED in Resend (free — add a few DNS records).
# Example once verified: "Doggli Pet Care <hello@doggli.com>"
BOOKING_FROM_EMAIL="Doggli Pet Care <onboarding@resend.dev>"
